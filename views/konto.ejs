<%- include('partials/head') %>

<header class="top">
  <div class="toprow">
    <h1 class="logo">👤 Konto</h1>
  </div>
</header>

<% if (ok) { %><div class="banner okay"><%= ok %></div><% } %>
<% if (err) { %><div class="banner err"><%= err %></div><% } %>

<div class="card">
  <p>Angemeldet als <b><%= user.username %></b><%= user.isAdmin ? ' (Admin)' : '' %></p>
  <form method="post" action="/logout">
    <button class="btn sec" type="submit">Abmelden</button>
  </form>
</div>

<div class="card">
  <h3>Passwort ändern</h3>
  <form method="post" action="/konto/passwort" class="stack">
    <input class="text" type="password" name="current" placeholder="Aktuelles Passwort" autocomplete="current-password" required>
    <input class="text" type="password" name="neu" placeholder="Neues Passwort (min. 6 Zeichen)" autocomplete="new-password" required minlength="6">
    <input class="text" type="password" name="neu2" placeholder="Neues Passwort wiederholen" autocomplete="new-password" required minlength="6">
    <button class="btn" type="submit">Speichern</button>
  </form>
</div>

<%- include('partials/foot') %>
